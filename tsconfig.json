{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2020" , "DOM"],
        "types": ["node"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "declaration": true,
        "paths": {
            "@Core/*": ["./src/Core/*"],
            "@Domain/*": ["./src/Domain/*"],
            "@Bootstrap/*": ["./src/Bootstrap/*"],
            "@Bots/*": ["./src/Bots/*"],
            "@Data/*": ["./src/Data/*"],
            "@Service/*": ["./src/Service/*"],
            "@Task/*": ["./src/Task/*"],
            "@Test/*": ["./src/Test/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}