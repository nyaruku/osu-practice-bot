{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020" , "DOM"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "paths": {
    //   "@Core/*": ["Core/*"],
    //   "@Domain/*": ["Domain/*"],
    //   "@Bootstrap/*": ["Bootstrap/*"],
    //   "@Service/*": ["Service/*"],
    //   "@Task/*": ["Task/*"],
    //   "@Test/*": ["Test/*"]
    }    
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}